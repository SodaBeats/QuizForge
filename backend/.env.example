DATABASE_URL=
DEV_HOST_HINT=

JWT_SECRET=
REFRESH_TOKEN_SECRET=

GROQ_API_KEY=

CORS_ORIGIN=

REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=

# Text embeddings (see src/lib/embedText.ts) — two environments, one switch:
# local dev → ollama (default, no key needed); production → jina (Jina AI cloud)
EMBEDDING_PROVIDER=ollama
# ollama provider only; defaults to mxbai-embed-large:latest (1024-dim)
EMBEDDING_MODEL=mxbai-embed-large:latest
# ollama provider only; defaults to http://localhost:11434
OLLAMA_HOST=
# REQUIRED when EMBEDDING_PROVIDER=jina
JINA_API_KEY=
# REQUIRED when EMBEDDING_PROVIDER=jina (e.g. jina-embeddings-v5-omni-small, 1024-dim)
JINA_EMBED_MODEL=
# jina provider only; defaults to https://api.jina.ai/v1 (EU: https://eu.api.jina.ai/v1)
JINA_BASE_URL=
# per-request timeout in ms; defaults to 120000
EMBEDDING_TIMEOUT_MS=