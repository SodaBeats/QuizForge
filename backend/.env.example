DATABASE_URL=
DEV_HOST_HINT=

JWT_SECRET=
REFRESH_TOKEN_SECRET=

GROQ_API_KEY=

CORS_ORIGIN=

REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=

# Text embeddings (see src/lib/embedText.ts)
# provider: 'ollama' (default, local) | 'openai' (any OpenAI-compatible /embeddings API)
EMBEDDING_PROVIDER=ollama
# default for ollama; REQUIRED (no default) for openai
EMBEDDING_MODEL=mxbai-embed-large:latest
# REQUIRED when EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
# openai provider only; defaults to https://api.openai.com/v1
EMBEDDING_BASE_URL=
# ollama provider only; defaults to http://localhost:11434
OLLAMA_HOST=
# per-request timeout in ms; defaults to 120000
EMBEDDING_TIMEOUT_MS=